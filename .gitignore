
# Environment variables and secrets
.env
.env.*
!.env.example
env/

# Node.js dependencies
node_modules/

# Composer dependencies
/vendor/

# Local private keys
*.ppk
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# PHPUnit cache
.phpunit.result.cache

# CodeIgniter writable files
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
/writable/debugbar/*

# Runtime databases
/writable/*.sqlite
/writable/*.sqlite3
/writable/*.db
/writable/humming_bird

# Runtime uploads
/writable/uploads/*
!/writable/uploads/index.html

# Generated test/build output
/build/
/writable/test_img.png

# Service-account credentials
*service-account*.json
*firebase-adminsdk*.json
/writable/credentials/

# Private credentials
/app/Controllers/pvKey.json

# Editor/SFTP settings
/.vscode/sftp.json

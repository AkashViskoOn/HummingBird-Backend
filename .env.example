# Humming Bird Backend Environment Configuration
# Copy this file to .env and fill in your values

# CI_ENVIRONMENT can be one of: development, testing, production
# CI_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# MySQL Database (production RDS connection)
# Required. app/Config/Database.php reads these — do not hardcode creds in code.
# ---------------------------------------------------------------------------
DB_HOSTNAME=your-mysql-host
DB_USERNAME=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_DATABASE=humming_bird
DB_PORT=3314

# JWT Secret for API authentication
JWT_SECRET=your-jwt-secret-here

# OpenAI API Key (used by AiService for all AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Encryption key for message encryption
ENCRYPTION_KEY=your-encryption-key-here

# MSG91 Auth Key for SMS
MSG91_AUTH_KEY=your-msg91-key-here

# FCM Service Account Path
FCM_SERVICE_ACCOUNT_PATH=app/Controllers/pvKey.json
INTERNAL_CRON_KEY=replace-with-a-long-random-secret

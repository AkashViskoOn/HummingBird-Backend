# Humming Bird Backend Environment Configuration
# Copy this file to .env and fill in your values

# CI_ENVIRONMENT can be one of: development, testing, production
# CI_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# MySQL Database (production RDS connection)
# Required. app/Config/Database.php reads these; do not hardcode credentials in code.
# ---------------------------------------------------------------------------
DB_HOSTNAME=localhost
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name
DB_PORT=3306

# JWT Secret for API authentication
JWT_SECRET=replace_with_a_long_random_secret

# Gemini API Key (used by AiService for all AI features)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the default Gemini model (defaults to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Encryption key for message encryption
ENCRYPTION_KEY=replace_with_a_secure_random_encryption_key

# MSG91 Auth Key for SMS
MSG91_AUTH_KEY=your_msg91_auth_key

# FCM Service Account Path
FCM_SERVICE_ACCOUNT_PATH=writable/credentials/firebase-service-account.json
INTERNAL_CRON_KEY=replace_with_a_long_random_internal_key
